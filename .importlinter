# =============================================================================
# Import Linter Configuration
# =============================================================================
# Enforces the layering from docs/architecture/architecture.md.
# Run with: lint-imports (or tools/lint_imports.sh / .bat)
# =============================================================================

[importlinter]
root_packages =
    agent_workbench
    tests
root_package_paths =
    src
    .
include_external_packages = True

# Dependencies flow downward only:
#   apps -> interfaces -> services -> adapters -> core
[importlinter:contract:layered_architecture]
name = Layered Architecture
type = layers
layers =
    agent_workbench.apps
    agent_workbench.interfaces
    agent_workbench.services
    agent_workbench.adapters
    agent_workbench.core

# Core holds the domain model only: no I/O-facing layer may leak into it.
[importlinter:contract:core_independence]
name = Core Independence
type = forbidden
source_modules =
    agent_workbench.core
forbidden_modules =
    agent_workbench.adapters
    agent_workbench.services
    agent_workbench.interfaces
    agent_workbench.apps

# Production code never imports from tests.
[importlinter:contract:no_test_imports_in_source]
name = Source Code Independence from Tests
type = forbidden
source_modules =
    agent_workbench
forbidden_modules =
    tests

# truststore: process-wide injection (adapters.ssl_setup) and the per-client SSL context of the
# copied model layer. Allowed in adapters only.
[importlinter:contract:truststore_isolation]
name = truststore only in adapters
type = forbidden
source_modules =
    agent_workbench
forbidden_modules =
    truststore
ignore_imports =
    agent_workbench.adapters.** -> truststore

# The copied model layer and the flat copies import no other agent_workbench module and never langgraph.
# import-linter skips a source/forbidden pair where one contains the other, so agent_workbench.* alone
# does not cover modules inside adapters: agent_workbench.adapters.* is forbidden as well.
[importlinter:contract:langchain_model_layer]
name = LangChain Model Layer Self-Contained
type = forbidden
source_modules =
    agent_workbench.adapters.langchain.anthropic_backend
    agent_workbench.adapters.langchain.gemini_backend
    agent_workbench.adapters.langchain.ollama_backend
    agent_workbench.adapters.langchain.openai_backend
    agent_workbench.adapters.langchain._models
    agent_workbench.adapters.langchain._setup
    agent_workbench.adapters.langchain._http
    agent_workbench.adapters.langchain._exceptions
    agent_workbench.adapters.langchain._errors_404
    agent_workbench.adapters.langchain._usage
    agent_workbench.adapters.langchain._preflight
    agent_workbench.adapters.langchain._config_diagnostics
    agent_workbench.adapters.langchain._messages
    agent_workbench.adapters.langchain._provider_checks
    agent_workbench.adapters.langchain._product
    agent_workbench.adapters.llm_types
    agent_workbench.adapters.config_hints
    agent_workbench.adapters.ssl_setup
    agent_workbench.adapters.toml_utils
forbidden_modules =
    agent_workbench.*
    agent_workbench.adapters.*
    langgraph
ignore_imports =
    agent_workbench.adapters.langchain._usage -> agent_workbench.adapters.llm_types
    agent_workbench.adapters.langchain._provider_checks -> agent_workbench.adapters.config_hints

[importlinter:contract:langchain_model_layer_ancestors]
name = LangChain Model Layer No Ancestor Imports
type = forbidden
as_packages = False
source_modules =
    agent_workbench.adapters.langchain.anthropic_backend
    agent_workbench.adapters.langchain.gemini_backend
    agent_workbench.adapters.langchain.ollama_backend
    agent_workbench.adapters.langchain.openai_backend
    agent_workbench.adapters.langchain._models
    agent_workbench.adapters.langchain._setup
    agent_workbench.adapters.langchain._http
    agent_workbench.adapters.langchain._exceptions
    agent_workbench.adapters.langchain._errors_404
    agent_workbench.adapters.langchain._usage
    agent_workbench.adapters.langchain._preflight
    agent_workbench.adapters.langchain._config_diagnostics
    agent_workbench.adapters.langchain._messages
    agent_workbench.adapters.langchain._provider_checks
    agent_workbench.adapters.langchain._product
    agent_workbench.adapters.llm_types
    agent_workbench.adapters.config_hints
    agent_workbench.adapters.ssl_setup
    agent_workbench.adapters.toml_utils
forbidden_modules =
    agent_workbench
    agent_workbench.adapters
    agent_workbench.adapters.langchain

# Third-party modules of the model layer: allowed in adapters only.
[importlinter:contract:langchain_core_isolation]
name = langchain_core only in adapters
type = forbidden
source_modules =
    agent_workbench
forbidden_modules =
    langchain_core
ignore_imports =
    agent_workbench.adapters.** -> langchain_core

